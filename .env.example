# Todas las variables son OPCIONALES. La demo despliega en Vercel sin ninguna.

# URL pública del sitio (canonical, sitemap, Open Graph). Si no se define,
# se usa https://grabadosgonzalezsimon.vercel.app
NEXT_PUBLIC_SITE_URL=

# Permitir que Google indexe la web (robots.txt + meta robots). Por defecto la
# demo NO se indexa. Poner a "true" solo al publicar en el dominio definitivo.
NEXT_PUBLIC_INDEXABLE=

# --- Futuro (no se usan en la demo) ---
# Envío real de formularios con Resend
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=grabadosgonzalezs@gmail.com

# Migración a Shopify (Storefront API) — ver SHOPIFY_MIGRATION.md
# SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
